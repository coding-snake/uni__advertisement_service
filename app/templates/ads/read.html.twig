{% extends 'base.html.twig' %}

{% block title %}
    {{ 'title.ad_details'|trans({'%id%': ad.id|default('')}) }}
{% endblock %}

{% block body %}
        <h1>{{ 'title.ad_details'|trans({'%id%': ad.id|default('')}) }}</h1>

        {% if ad is defined and ad|length %}
        <dl class="dl-horizontal">
            <dt>{{ 'label.author'|trans }}</dt>
            <dd>
            {% if ad.author %}
                {{ ad.author.username }}
            {% else %}
                {{ 'message.added_by_guest'|trans }}
            {% endif %}
            </dd>
            {% if is_granted('ROLE_ADMIN') %}
            <dt>{{'label.verification'|trans}}</dt>
            <dd>
                {{ ad.verified ? 'label.yes'|trans : 'label.no'|trans }}
            <br><br>
            <form method="post"
                action="{{ path('ad_toggle_verification', {'id': ad.id}) }}"
                style="display:inline">

                <button type="submit" class="btn btn-primary">
                    {{ 'action.change_verification'|trans }}
                </button>

            </form>
            
            </dd>
            {% endif %}

            <dt>{{ 'label.id'|trans }}</dt>
            <dd>{{ ad.id }}</dd>
            <dt>{{ 'label.tags'|trans }}</dt>
            <dd>
            {% for tag in ad.tags %}
                {{ tag.name }}{% if not loop.last %}, {% else %}.{% endif %}
            {% endfor %}
            </dd>
            <dt>{{ 'label.createdAt'|trans }}</dt>
            <dd>{{ ad.createdAt|format_date('long') }}</dd>
            <dt>{{ 'label.updatedAt'|trans }}</dt>
            <dd>{{ ad.updatedAt|format_date('long') }}</dd>
            <dt>{{ 'label.name'|trans }}</dt>
            <dd>{{  ad.name }}</dd>
            <dt>{{ 'label.topic'|trans }}</dt>
            <dd>{{  ad.topic.name }}</dd>
            <dt>{{ 'label.content'|trans }}</dt>
            <dd>{{  ad.content }}</dd>
        </dl>
    <br>

    {% else %}
        <p>
            {{ 'message.ad_not_found'|trans }}
        </p>
    {% endif %}

    <button type="button" class="btn btn-secondary" onclick="window.location.href='{{ path('ad_index') }}'">
        <img src="{{ asset('images/arrow-return-left.svg') }}" alt="View" width="30" height="24">
        {{'action.go_back_to_ads'|trans}}
    </button>


{% endblock %}