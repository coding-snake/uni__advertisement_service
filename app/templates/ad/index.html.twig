{% extends 'base.html.twig' %}

{% block title %}
    {{ 'title.ad_list'|trans }}
{% endblock %}

{% block body %}
    <h1>{{ 'title.ad_list'|trans }}</h1>
    <button type="button" class="btn btn-secondary" onclick="window.location.href=#">
        <img src="{{ asset('images/plus-circle.svg') }}" alt="View" width="30" height="24">
        {{ 'action.create'|trans }}
    </button>


    {% if ads is defined and ads|length %}
        <table class="table table-striped">
            <thead>
            <tr>
                <th scope="row">{{ 'label.id'|trans }}</th>
                <th>{{ 'label.name'|trans }}</th>
                <th>
                {{ 'label.topic'|trans }}</th>
                <th scope="rowgroup">
                    {{ 'label.actions'|trans }}
                </th>
            </tr>
            </thead>
            <tbody>
            {% for ad in ads %}
                <tr>
                    <td scope="row">{{ ad.id }}</td>
                    <td>{{ ad.name }}</td>
                    <td> {{ 'label.topic'|trans }} </td>
                    <td>
                    <button type="button" class="btn btn-primary" onclick="window.location.href='{{ path('ad_view', { id: ad.id }) }}'">
                        <img src="{{ asset('images/eye.svg') }}" alt="View" width="30" height="24">
                        {{ 'action.view'|trans }}
                    </button>
                    <button type="button" class="btn btn-success" onclick="window.location.href='{{ path('ad_view', { id: ad.id }) }}'">
                        <img src="{{ asset('images/pencil-fill.svg') }}" alt="View" width="30" height="24">
                        {{ 'action.edit'|trans }}
                    </button>
                    <button type="button" class="btn btn-danger" onclick="window.location.href='{{ path('ad_view', { id: ad.id }) }}'">
                        <img src="{{ asset('images/trash3.svg') }}" alt="View" width="30" height="24">
                        {{ 'action.delete'|trans }}
                    </button>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p>
            {{ 'message.empty_list'|trans }}
        </p>
    {% endif %}
{% endblock  %}