{% extends 'base.html.twig' %}

{% block title %}
    {{ 'title.topic_details'|trans({'%id%': topic.id|default('')}) }}
{% endblock %}

{% block body %}
        <h1>{{ 'title.topic_details'|trans({'%id%': topic.id|default('')}) }}</h1>

        {% if topic is defined and topic|length %}
        <dl class="dl-horizontal">
            <dt>{{ 'label.id'|trans }}</dt>
            <dd>{{ topic.id }}</dd>
            </dd>
            <dt>{{ 'label.createdAt'|trans }}</dt>
            <dd>{{ topic.createdAt|date('Y/m/d') }}</dd>
            <dt>{{ 'label.updatedAt'|trans }}</dt>
            <dd>{{ topic.updatedAt|date('Y/m/d') }}</dd>
            <dt>{{ 'label.name'|trans }}</dt>
            <dd>{{  topic.name }}</dd>
        </dl>
    {% else %}
        <p>
            {{ 'message.ad_not_found'|trans }}
        </p>
    {% endif %}

    <button type="button" class="btn btn-secondary" onclick="window.location.href='{{ path('topic_index') }}'">
        <img src="{{ asset('images/arrow-return-left.svg') }}" alt="View" width="30" height="24">
        {{'action.go_back'|trans}}
    </button>


{% endblock %}