{% extends 'base.html.twig' %}

{% block title %}{{'title.user_list'|trans}}{% endblock %}

{% block body %}
    <h1>{{'title.user_list'|trans}}</h1>

    <table class="table">
        <thead>
            <tr>
                <th>{{ knp_pagination_sortable(pagination, 'label.id'|trans, 'u.id') }}</th>
                <th>{{ knp_pagination_sortable(pagination, 'label.email'|trans, 'u.email') }}</th>
                <th>{{ knp_pagination_sortable(pagination, 'label.username'|trans, 'u.username') }}</th>
                <th>{{'label.roles'|trans}}</th>
                <th>{{'label.actions'|trans}}</th>
            </tr>
        </thead>
        <tbody>
        {% for user in pagination %}
            <tr>
                <td>{{ user.id }}</td>
                <td>{{ user.email }}</td>
                <td>{{ user.username }}</td>
                <td>{{ user.roles|join(', ') }}</td>
                <td>
                <button type="button" class="btn btn-primary" onclick="window.location.href='{{ path('admin_user_edit_username', {'id': user.id}) }}'">{{ 'action.edit_username'|trans }}</button>
                <button type="button" class="btn btn-primary" onclick="window.location.href='{{ path('admin_user_edit_password', {'id': user.id}) }}'">{{ 'action.edit_password'|trans }}</button>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">{{'message.no_users_found'|trans}}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <div class="navigation">
        {{ knp_pagination_render(pagination) }}
    </div>
{% endblock %}