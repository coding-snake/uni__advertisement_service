{% extends 'base.html.twig' %}

{% block title %}
    {{ 'title.tag_details'|trans({'%id%': tag.id|default('')}) }}
{% endblock %}

{% block body %}
        <h1>{{ 'title.tag_details'|trans({'%id%': tag.id|default('')}) }}</h1>

        {% if tag is defined and tag|length %}
        <dl class="dl-horizontal">
        
            <dt>{{ 'label.author'|trans }}</dt>
            <dd>
            {% if tag.author %}
                {{ tag.author.username }}
            {% else %}
                {{ 'message.added_by_guest'|trans }}
            {% endif %}
            </dd>
            <dt>{{ 'label.id'|trans }}</dt>
            <dd>{{ tag.id }}</dd>
            </dd>
            <dt>{{ 'label.createdAt'|trans }}</dt>
            <dd>{{ tag.createdAt|format_date('long') }}</dd>
            <dt>{{ 'label.updatedAt'|trans }}</dt>
            <dd>{{ tag.updatedAt|format_date('long') }}</dd>
            <dt>{{ 'label.name'|trans }}</dt>
            <dd>{{  tag.name }}</dd>
        </dl>
    {% else %}
        <p>
            {{ 'message.ad_not_found'|trans }}
        </p>
    {% endif %}

    <button type="button" class="btn btn-secondary" onclick="window.location.href='{{ path('tag_index') }}'">
        <img src="{{ asset('images/arrow-return-left.svg') }}" alt="View" width="30" height="24">
        {{'action.go_back'|trans}}
    </button>


{% endblock %}