{% extends 'base.html.twig' %}

{% block name %}
    {{ 'name.tag_list'|trans }}
{% endblock %}

{% block body %}
    <h1>{{ 'name.tag_list'|trans }}</h1>
<button type="button" class="btn btn-secondary" onclick="window.location.href=#" style="margin-top:2rem; margin-bottom:2rem;">
        <img src="{{ asset('images/plus-circle.svg') }}" alt="View" width="30" height="24">
        {{ 'action.create'|trans }}
    </button>
    {% if pagination is defined and pagination.items|length %}

        <div class="navigation text-center">
            {{ knp_pagination_render(pagination) }}
        </div>

        <table class="table table-striped">
            <thead>
            <tr>
                <th>{{ knp_pagination_sortable(pagination, 'label.id'|trans, 'tag.id') }}</th>
                <th>{{ knp_pagination_sortable(pagination, 'label.createdAt'|trans, 'tag.createdAt') }}</th>
                <th>{{ knp_pagination_sortable(pagination, 'label.updatedAt'|trans, 'tag.updatedAt') }}</th>
                <th>{{ knp_pagination_sortable(pagination, 'label.name'|trans, 'tag.name') }}</th>
                <th>{{ 'label.actions'|trans }}</th>
            </tr>
            </thead>
            <tbody>
            {% for tag in pagination.items %}
                <tr>
                    <td>{{ tag.id }}</td>
                    <td>{{ tag.createdAt|format_date('long') }}</td>
                    <td>{{ tag.updatedAt|format_date('long') }}</td>
                    <td>{{ tag.name }}</td>
                    <td>
                        <button type="button" class="btn btn-primary" onclick="window.location.href='{{ path('tag_read', { id: tag.id }) }}'">
                        <img src="{{ asset('images/eye.svg') }}" alt="View" width="30" height="24">
                        {{ 'action.read'|trans }}
                    </button>
                    <button type="button" class="btn btn-success" onclick="window.location.href='{{ path('tag_read', { id: tag.id }) }}'">
                        <img src="{{ asset('images/pencil-fill.svg') }}" alt="View" width="30" height="24">
                        {{ 'action.edit'|trans }}
                    </button>
                    <button type="button" class="btn btn-danger" onclick="window.location.href='{{ path('tag_read', { id: tag.id }) }}'">
                        <img src="{{ asset('images/trash3.svg') }}" alt="View" width="30" height="24">
                        {{ 'action.delete'|trans }}
                    </button>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        <div class="navigation text-center">
            {{ knp_pagination_render(pagination) }}
        </div>

    {% else %}
        <p>
            {{ 'message.empty_list'|trans }}
        </p>
    {% endif %}
{% endblock %}